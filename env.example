# توکن ربات از @BotFather
BOT_TOKEN=123456:ABC-your-token

# آیدی عددی ادمین‌ها (از @userinfobot بگیرید)، با کاما جدا کنید
ADMIN_IDS=111111111

# دو کانال اسپانسر (حتما ربات را در هر دو کانال ادمین کنید)
SPONSOR_CHANNELS=@sponsor_channel_1,@sponsor_channel_2

# مسیر دیتابیس
DB_PATH=bot.db

# 1 = جلوگیری از فوروارد و ذخیره ویدیو، 0 = آزاد
PROTECT_CONTENT=1
